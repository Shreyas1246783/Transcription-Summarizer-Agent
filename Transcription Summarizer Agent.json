        "jsCode": "// This tries to find the input in 'text', 'chatInput', or 'message'\nconst input = $json.text || $json.chatInput || $json.message || \"\";\n\nconst regex = /(?:youtube\\.com\\/(?:[^\\/]+\\/.+\\/|(?:v|e(?:mbed)?)\\/|.*[?&]v=)|youtu\\.be\\/)([^\"&?\\/\\s]{11})/;\nconst match = input.match(regex);\n\nif (match && match[1]) {\n  return { videoId: match[1] };\n} else {\n  // If it fails, it will show you exactly what it received so you can debug\n  throw new Error(`Could not find Video ID. I received: \"${input}\"`);\n}"
